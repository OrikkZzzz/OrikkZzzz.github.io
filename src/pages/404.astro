---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="404">
  <div class="container notfound">
    <h1>404</h1>
    <p>页面不存在。</p>
    <a href="/">← 回首页</a>
  </div>
</BaseLayout>

<style>
  .notfound { text-align: center; padding: 5rem 0; }
  .notfound h1 { font-size: 4rem; margin: 0; color: var(--accent); }
  .notfound p { color: var(--text-dim); }
</style>
