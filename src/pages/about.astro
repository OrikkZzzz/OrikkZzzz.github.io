---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config';
---
<BaseLayout title="About">
  <div class="container">
    <h1 class="page-title" data-i18n="about.title">关于我</h1>

    <div class="prose lang-zh">
      <p>
        你好,我是 <strong>{SITE.author}</strong>。
        <span data-i18n="about.identity">现为华中科技大学人工智能专业本科生。</span>
      </p>
      <p>
        这个网站是用 <a href="https://astro.build" target="_blank" rel="noopener">Astro</a> 搭起来的,
        托管在 GitHub Pages 上。主要用来记录学习笔记、折腾过程和一些随笔。
      </p>
      <h2>关于这个网站</h2>
      <ul>
        <li>由 Astro 静态生成,加载快、SEO 好</li>
        <li>支持暗色 / 亮色 / 跟随系统三种背景</li>
        <li>支持中英文切换</li>
        <li>文章用 Markdown 编写,通过 Git 发布</li>
      </ul>
      <h2>联系方式</h2>
      <ul>
        <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
        <li><a href="https://github.com/OrikkZzzz" target="_blank" rel="noopener">GitHub</a></li>
      </ul>
    </div>

    <div class="prose lang-en">
      <p>
        Hi, I'm <strong>{SITE.author}</strong>.
        <span data-i18n="about.identity_en">An undergraduate student in Artificial Intelligence at HUST.</span>
      </p>
      <p>
        This site is built with <a href="https://astro.build" target="_blank" rel="noopener">Astro</a> and hosted on
        GitHub Pages. It's a place for my study notes, experiments, and random writings.
      </p>
      <h2>About this site</h2>
      <ul>
        <li>Generated statically with Astro, fast and SEO-friendly</li>
        <li>Dark / Light / Auto theme support</li>
        <li>Chinese / English toggle</li>
        <li>Articles written in Markdown, published via Git</li>
      </ul>
      <h2>Contact</h2>
      <ul>
        <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
        <li><a href="https://github.com/OrikkZzzz" target="_blank" rel="noopener">GitHub</a></li>
      </ul>
    </div>
  </div>
</BaseLayout>

<style>
  .lang-en { display: none; }
  :global(html[data-lang="en"]) .lang-zh { display: none; }
  :global(html[data-lang="en"]) .lang-en { display: block; }
  :global(html[data-lang="zh"]) .lang-en { display: none; }
</style>
