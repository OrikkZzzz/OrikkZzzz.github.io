---
import { WALINE } from '../config';
// Waline 评论组件样式(必须有,否则评论框渲染不出来)
import '@waline/client/style';
const hasServer = !!WALINE.serverURL;
---
<section class="waline-wrap">
  <h2 class="waline-heading">💬 评论</h2>
  {!hasServer ? (
    <p class="waline-note">
      评论系统尚未启用。请在
      <code>src/config.ts</code> 的 <code>WALINE.serverURL</code> 填入你部署好的 Waline 地址(例如
      <code>https://xxx.vercel.app</code>)。
    </p>
  ) : (
    <div id="waline" data-serverurl={WALINE.serverURL}></div>
  )}
</section>

{WALINE.enabled && hasServer && (
  <script>
    (async () => {
      try {
        const el = document.querySelector('#waline');
        const serverURL = el ? el.dataset.serverurl : '';
        // 动态导入 full 构建(含完整评论组件);Astro 会打包成模块,浏览器按 chunk 加载
        const mod = await import('@waline/client/full');
        const init = mod.init || mod.default;
        init({
          el: '#waline',
          serverURL,
          dark: 'media',
        });
      } catch (e) {
        console.error('Waline 初始化失败:', e);
      }
    })();
  </script>
)}

<style>
  .waline-wrap { margin-top: 3rem; }
  .waline-heading { font-size: 1.15rem; border-bottom: 1px solid var(--border); padding-bottom: .5em; }
  .waline-note {
    color: var(--text-dim);
    background: var(--card);
    border: 1px dashed var(--border);
    border-radius: var(--radius);
    padding: 14px 16px;
  }
</style>
